# Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env!
# See the "Configuration & Integrations" section in the root README.md
# for what each of these is for and how to obtain it.

# ─── Core (always required) ──────────────────────────────────────────────
# PostgreSQL connection string (e.g., from Neon.tech)
DATABASE_URL=
DIRECT_URL=

# Secret keys for signing JWTs (use long, random, DIFFERENT strings for
# each — never reuse one for the other). Both are required: the server
# refuses to start if either is unset.
JWT_SECRET=replace_with_a_strong_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret

# Allowed origin for CORS (your frontend URL)
FRONTEND_URL=http://localhost:3000

# Server port
PORT=5001

# Set to "production" in production — gates whether GCP Secret Manager /
# the Gmail API are used at all (see below); everything runs in local/dev
# fallback mode otherwise.
NODE_ENV=

# ─── Google Sign-In ("Sign in with Google" login) ────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console > APIs & Services >
# Credentials > Create Credentials > OAuth client ID (type: Web
# application). Used here to verify Google ID tokens on login — the SAME
# client ID must also be set as VITE_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=

# ─── Secret storage (raw vault passwords) ────────────────────────────────
# Passwords are never stored in Postgres directly. In production, with a
# real GCP project, this uses Google Cloud Secret Manager. Without that
# configured, it falls back to storing an AES-256 encrypted blob in
# Postgres instead — SECRET_ENCRYPTION_KEY is the key for that fallback
# path and MUST be set to a long random string in any real deployment;
# don't rely on the default.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
SECRET_ENCRYPTION_KEY=replace_with_a_long_random_string

# ─── Google Workspace monitoring (optional feature) ──────────────────────
# Requires a GCP service account with domain-wide delegation, authorized
# in the Workspace Admin Console for the Admin SDK Reports/Directory
# scopes and the Cloud Identity Devices scope. Not configured = this
# feature silently no-ops.
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_WORKSPACE_SA_KEY_PATH=

# ─── Discord approve/deny from chat (optional feature) ───────────────────
# Outbound webhook alerts (Discord/Google Chat) are configured in-app —
# Settings page, ADMIN only — NOT via env vars. These three are only
# needed for the inbound "Approve"/"Deny" buttons on a Discord alert to
# work; from the Discord Developer Portal, on your bot's application:
#   DISCORD_BOT_TOKEN        Bot tab > Reset Token
#   DISCORD_PUBLIC_KEY       General Information tab > Public Key
#   DISCORD_APPLICATION_ID   General Information tab > Application ID
# Also set your app's "Interactions Endpoint URL" (General Information
# tab) to <FRONTEND_URL-equivalent-backend-url>/api/integrations/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# ─── Email notifications (optional) ──────────────────────────────────────
# Sent via the Gmail API using GOOGLE_APPLICATION_CREDENTIALS above (needs
# the gmail.send scope authorized for domain-wide delegation) — only
# active when NODE_ENV=production and GOOGLE_APPLICATION_CREDENTIALS is
# set; otherwise emails are just logged to the console.
GMAIL_SENDER=

# ─── Session cache (optional) ────────────────────────────────────────────
# Defaults to redis://localhost:6379 if unset.
REDIS_URL=
