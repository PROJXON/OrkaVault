# Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env!

# PostgreSQL connection string (e.g., from Neon.tech)
DATABASE_URL=
DIRECT_URL=
#Discord Bot Token for Approve/Deny ability
DISCORD_BOT_TOKEN=
# Secret key for signing JWTs (use a long, random string). Both of these
# are required — the server refuses to start if either is unset.
JWT_SECRET=replace_with_a_strong_random_secret
# Separate secret key for signing refresh tokens (use a different long,
# random string than JWT_SECRET)
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret

# Allowed origin for CORS (your frontend URL)
FRONTEND_URL=http://localhost:3000

# Server port
PORT=5001

#GoogleWorkspace Super Admin Email for Workspace Activity Feature
GOOGLE_WORKSPACE_ADMIN_EMAIL=