datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  googleId         String?   @unique
  passwordHash     String?
  role             Role      @default(USER)
  startDate        DateTime  @default(now())
  endDate          DateTime?
  active           Boolean   @default(false)  // false until admin approves registration
  revoked          Boolean   @default(false)  // true if registration declined or access revoked
  notificationsOn  Boolean   @default(true)
  department       String?
  clearanceLevel   String?
  internationalAccess Boolean @default(false)
  devices          String[]  @default([])
  avatarUrl        String?
  favorites        String[]  @default([])
  discordUserId    String?   @unique // linked via Profile "Link Discord" flow; enables /orkavault approve|deny from Discord
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  mfaDevices       MfaDevice[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accessGrants     AccessGrant[]
  accessRequests   AccessRequest[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  managedCollections Collection[] @relation("ManagedCollections")
}

model MfaDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  publicKey  String   // JSON string of JWK public key
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
}

enum Role {
  USER
  MANAGER
  ADMIN
}

model Account {
  id              String    @id @default(uuid())
  name            String
  username        String
  platformType    PlatformType
  secretRef       String    // Google Cloud Secret Manager resource ID
  ownerId         String
  healthScore     Int       @default(0)    // 0-100
  healthLabel     HealthLabel @default(WEAK)
  refreshCycle    RefreshCycle @default(FOUR_MONTHS)
  nextRotationDue DateTime?
  lastUpdatedBy   String?
  lastUpdatedAt   DateTime?
  qaStatus        QAStatus  @default(PENDING)
  notes           String?
  passwordHash    String?
  totpQrBase64    String?
  isGoogleSSO     Boolean   @default(false)
  requiredClearance String? // one of the free-text tiers on User.clearanceLevel; null = no requirement
  createdAt       DateTime  @default(now())
  createdBy       String

  collectionId    String?
  collection      Collection? @relation(fields: [collectionId], references: [id])

  accessGrants    AccessGrant[]
  accessRequests  AccessRequest[]
  auditLogs       AuditLog[]
  rotationSchedule RotationSchedule?
}

enum PlatformType {
  GOOGLE_WORKSPACE
  THIRD_PARTY
  FINANCE
}

enum HealthLabel {
  WEAK
  MEDIUM
  STRONG
}

enum RefreshCycle {
  MONTHLY
  FOUR_MONTHS
  SIX_MONTHS
  ANNUALLY
  MANUAL
}

enum QAStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccessGrant {
  id          String    @id @default(uuid())
  accountId   String
  userId      String
  grantedBy   String
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  accessType  String    @default("ONGOING")
  active      Boolean   @default(true)

  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccessRequest {
  id            String        @id @default(uuid())
  accountId     String
  requesterId   String
  requestType   RequestType
  reason        String
  deviceName    String?
  location      String?
  internationalAccessRequested Boolean @default(false)
  status        RequestStatus @default(PENDING)
  actionedBy    String?
  actionedAt    DateTime?
  submittedAt   DateTime      @default(now())

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requester     User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
}

enum RequestType {
  VIEW_90S
  TEMP_24H
  ONGOING
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String
  accountId   String?
  action      String
  metadata    Json?
  ipAddress   String?
  timestamp   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model RotationSchedule {
  id              String        @id @default(uuid())
  accountId       String        @unique
  cycle           RefreshCycle
  lastRotated     DateTime?
  nextDue         DateTime
  alertDaysBefore Int           @default(7)

  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  title       String
  body        String
  type        NotifType
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotifType {
  ACCESS_REQUEST
  ACCESS_APPROVED
  ACCESS_DENIED
  PASSWORD_WEAK
  ROTATION_DUE
  OFFBOARDING_ALERT
  REGISTRATION_APPROVED
  NEW_ENTRY_QA
  WORKSPACE_SUSPICIOUS_LOGIN
  WORKSPACE_NEW_OAUTH_APP
  WORKSPACE_LOGIN_ALLOWLIST_VIOLATION
}

model WorkspaceActivityEvent {
  id              String   @id @default(uuid())
  userEmail       String
  eventType       String // "login_success" | "login_failure" | "suspicious_login" | "oauth_token_grant" | "oauth_token_revoke"
  appName         String?
  ipAddress       String?
  regionCode      String? // ISO 3166-1 alpha-2, from Google's networkInfo.regionCode — approximate, not always present. NOTE: this is the IP that made *this specific Google API call* — for an oauth_token_grant via third-party SSO, that's the third-party app's server, not necessarily the end user's location.
  subdivisionCode String? // ISO 3166-2 (state/province), from networkInfo.subdivisionCode
  flagged         Boolean  @default(false)
  occurredAt      DateTime
  uniqueQualifier String?
  raw             Json
  createdAt       DateTime @default(now())

  @@index([occurredAt])
  @@index([userEmail])
}

// Current-state snapshot of a user's connected third-party OAuth apps
// (Directory API tokens.list), distinct from WorkspaceActivityEvent's
// append-only audit trail of grant/revoke actions. Each sync upserts on
// (userEmail, clientId) and deletes rows no longer returned by Google
// (= app was disconnected) — see services/googleWorkspace.ts.
model ConnectedApp {
  id         String   @id @default(uuid())
  userEmail  String
  clientId   String
  appName    String?
  scopes     String[]
  nativeApp  Boolean  @default(false)
  anonymous  Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userEmail, clientId])
  @@index([userEmail])
}

// Current-state snapshot of devices associated with each Workspace user,
// from the Cloud Identity Devices API (devices.list + devices.deviceUsers.list)
// — a genuinely different Google API/credential requirement than the
// Reports API events above (needs Endpoint Verification/GCPW/Drive for
// Desktop actually installed on the device, plus the cloud-identity.devices
// scope). This is deliberately NOT correlated to individual
// WorkspaceActivityEvent rows — Google's Reports API login/token events
// don't carry per-event device info at all, so there's no reliable way to
// tie a specific login to a specific row here. Each sync upserts on
// (userEmail, deviceId) and deletes rows no longer returned by Google.
model WorkspaceDevice {
  id              String    @id @default(uuid())
  userEmail       String
  deviceId        String
  deviceType      String? // WINDOWS | MAC_OS | IOS | ANDROID | CHROME_OS | LINUX | GOOGLE_SYNC | DEVICE_TYPE_UNSPECIFIED
  model           String?
  osVersion       String?
  managementState String? // APPROVED | BLOCKED | PENDING | UNPROVISIONED | WIPING | WIPED
  lastSyncTime    DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userEmail, deviceId])
  @@index([userEmail])
}

model OrganizationPolicy {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String
  value       String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Collection {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts    Account[]
  managers    User[]   @relation("ManagedCollections")
}

// Configurable list of department names (Settings → Departments tab).
// User.department stays a free-text String (not a relation) — it's just
// validated/populated against this list, so existing user rows never need
// a backfill/migration if a department is later renamed or removed.
model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

