server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # CSP (report-only), generated by `vite build` from csp.config.js and
    # copied in by the Dockerfile.
    include /etc/nginx/snippets/csp.conf;

    # SPA: unknown paths fall back to index.html (same behavior as vercel.json's rewrite)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
