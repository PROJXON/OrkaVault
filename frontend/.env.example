# Frontend Environment Variables
# Copy this file to .env and fill in your values.
# In local development, this can be left blank (defaults to localhost).

# Your deployed backend API URL (leave empty for local development)
VITE_API_URL=

# Same OAuth 2.0 Client ID as backend/.env's GOOGLE_CLIENT_ID — powers the
# "Sign in with Google" button. Without it, Google login silently fails.
VITE_GOOGLE_CLIENT_ID=
