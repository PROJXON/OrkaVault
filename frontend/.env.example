# Frontend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env!
# Vite inlines VITE_* values into the bundle at build time, so they are
# public: never put a secret here. For CI/Firebase builds, set them as
# GitHub Actions variables, not in a committed file.

# Base URL of the backend API. "/api" is appended if omitted, and it
# defaults to http://localhost:5001 if unset (src/lib/api.js). Its origin is
# also written into the CSP's connect-src/img-src (csp.config.js).
# Production example: https://api.draipify.com/api
VITE_API_URL=http://localhost:5001/api

# Google OAuth 2.0 Web client ID (Google Cloud Console → APIs & Services →
# Credentials). Must match the backend's GOOGLE_CLIENT_ID. If unset, the
# Google sign-in button is hidden.
VITE_GOOGLE_CLIENT_ID=
